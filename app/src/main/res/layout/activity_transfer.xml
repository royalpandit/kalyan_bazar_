<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <RelativeLayout
        android:background="@color/red"

        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/rl_tool"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp">

        <include
            android:id="@+id/toolbar"
            layout="@layout/header" />
    </RelativeLayout>
        <androidx.cardview.widget.CardView
            android:layout_margin="@dimen/_10sdp"
            app:cardCornerRadius="@dimen/_5sdp"
            android:layout_below="@+id/rl_tool"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        <LinearLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/rl_tool"
            android:orientation="vertical">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:id="@+id/ll_bid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:orientation="vertical">

                       <LinearLayout
                        android:id="@+id/llPoints"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="20dp"
                            android:paddingVertical="10dp"
                            android:text="@string/point"
                            android:textColor="@color/black_dark"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/inputCoins"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="20dp"
                            android:background="@drawable/edit_bg"
                             android:hint="@string/enterpoints"
                            android:inputType="number"
                            android:maxLength="9"
                            android:textColorHint="@color/black"
                            android:paddingHorizontal="20dp"
                            android:paddingVertical="10dp"
                            android:textColor="@color/black_dark" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/llNumber"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="20dp"
                            android:paddingVertical="10dp"
                            android:text="@string/mobile_number"
                            android:textColor="@color/black_dark"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/inputNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="20dp"
                            android:background="@drawable/edit_bg"
                             android:hint="Enter Mobile Number"
                            android:inputType="number"
                            android:maxLength="10"
                            android:textColorHint="@color/black"
                            android:paddingHorizontal="20dp"
                            android:paddingVertical="10dp"
                            android:textColor="@color/black_dark" />
                    </LinearLayout>
                    <Button
                        android:id="@+id/btn_proceed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="@color/red"
                        android:gravity="center"
                        android:paddingHorizontal="40dp"
                        android:paddingVertical="12dp"
                        android:text="@string/prf1boceed"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        app:cornerRadius="20dp" />
                    <RelativeLayout
                        android:visibility="gone"
                        android:id="@+id/rlwhatsup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tvregister"
                        android:layout_centerInParent="true"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/ivWhatsupp"
                            android:layout_width="@dimen/_40sdp"
                            android:layout_height="@dimen/_40sdp"
                            android:src="@drawable/whatsups"
                            android:tint="@color/green"
                            tools:ignore="UseAppTint" />

                        <TextView
                            android:id="@+id/tvsupport"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/ivWhatsupp"
                            android:text="Support"
                            android:textColor="@color/black" />


                    </RelativeLayout>
                </LinearLayout>

            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>
</layout>